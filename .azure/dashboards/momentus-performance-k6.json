                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "min_duration",
                      "data_source": "metrics",
                      "aggregator": "min",
                      "query": "min:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}"
                    },
                    {
                      "name": "max_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "max:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}"
                    },
                    {
                      "name": "total_ms",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}.rollup(sum, 60)"
                    },
                    {
                      "name": "count_total",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "count:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}.rollup(sum, 60)"
                    },
                    {
                      "name": "failed_checks",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.checks.total{condition:zero,$service,$site,$scenario,$build_number} by {scenario,group}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "count_per_minute",
                      "data_source": "metrics",
                      "aggregator": "avg",
                      "query": "count:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}.rollup(sum, 60)"
                    },
                    {
                      "name": "p50_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "p50:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}.rollup(900)"
                    },
                    {
                      "name": "p90_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "p90:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}.rollup(900)"
                    },
                    {
                      "name": "p95_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "p95:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}.rollup(900)"
                    },
                    {
                      "name": "p99_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "p99:k6perf.group_duration{$service,$site,$scenario,$build_number} by {scenario,group}.rollup(900)"
                    }
                  ],
                  "formulas": [
                    { "alias": "Min (ms)", "cell_display_mode": "number", "formula": "min_duration" },
                    { "alias": "Max (ms)", "cell_display_mode": "number", "formula": "max_duration" },
                    { "alias": "Avg (ms)", "cell_display_mode": "bar", "formula": "total_ms / count_total" },
                    { "alias": "Count", "cell_display_mode": "number", "formula": "count_total" },
                    {
                      "alias": "Failed checks",
                      "cell_display_mode": "number",
                      "formula": "failed_checks",
                      "conditional_formats": [
                        { "comparator": "<=", "value": 0, "palette": "green_on_white" },
                        { "comparator": ">", "value": 0, "palette": "white_on_red" }
                      ]
                    },
                    { "alias": "Count/min", "cell_display_mode": "number", "formula": "count_per_minute" },
                    { "alias": "p50 (ms)", "cell_display_mode": "number", "formula": "p50_duration" },
                    { "alias": "p90 (ms)", "cell_display_mode": "number", "formula": "p90_duration" },
                    { "alias": "p95 (ms)", "cell_display_mode": "number", "formula": "p95_duration" },
                    { "alias": "p99 (ms)", "cell_display_mode": "number", "formula": "p99_duration" }
                  ],
                  "limit": 100,
                  "sort": { "count": 100, "order_by": [{ "index": 2, "order": "desc", "type": "formula" }] }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": 7005360946344282,
      "definition": {
        "title": "Requests table",
        "type": "group",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "id": 5278206471481845,
            "definition": {
              "title": "All requests: one row per tagged request, sorted by average duration. Percentiles are the worst 15-minute merge window, not the whole run.",
              "title_align": "left",
              "title_size": "16",
              "type": "query_table",
              "has_search_bar": "auto",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "min_duration",
                      "data_source": "metrics",
                      "aggregator": "min",
                      "query": "min:k6perf.http_req_duration{$service,$site,$scenario,$build_number} by {scenario,group,name}"
                    },
                    {
                      "name": "max_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "max:k6perf.http_req_duration{$service,$site,$scenario,$build_number} by {scenario,group,name}"
                    },
                    {
                      "name": "total_ms",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.http_req_duration{$service,$site,$scenario,$build_number} by {scenario,group,name}.rollup(sum, 60)"
                    },
                    {
                      "name": "request_count",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.http_reqs{$service,$site,$scenario,$build_number} by {scenario,group,name}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "failed_count",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.http_req_failed.total{condition:nonzero,$service,$site,$scenario,$build_number} by {scenario,group,name}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "response_count",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.http_req_failed.total{$service,$site,$scenario,$build_number} by {scenario,group,name}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "requests_per_minute",
                      "data_source": "metrics",
                      "aggregator": "avg",
                      "query": "sum:k6perf.http_reqs{$service,$site,$scenario,$build_number} by {scenario,group,name}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "p90_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "p90:k6perf.http_req_duration{$service,$site,$scenario,$build_number} by {scenario,group,name}.rollup(900)"
                    },
                    {
                      "name": "p95_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "p95:k6perf.http_req_duration{$service,$site,$scenario,$build_number} by {scenario,group,name}.rollup(900)"
                    },
                    {
                      "name": "p99_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "p99:k6perf.http_req_duration{$service,$site,$scenario,$build_number} by {scenario,group,name}.rollup(900)"
                    }
                  ],
                  "formulas": [
                    { "alias": "Min (ms)", "cell_display_mode": "number", "formula": "min_duration" },
                    { "alias": "Max (ms)", "cell_display_mode": "number", "formula": "max_duration" },
                    { "alias": "Avg (ms)", "cell_display_mode": "bar", "formula": "total_ms / request_count" },
                    { "alias": "Count", "cell_display_mode": "number", "formula": "request_count" },
                    {
                      "alias": "Errors",
                      "cell_display_mode": "number",
                      "formula": "failed_count",
                      "conditional_formats": [
                        { "comparator": "<=", "value": 0, "palette": "green_on_white" },
                        { "comparator": ">", "value": 0, "palette": "white_on_red" }
                      ]
                    },
                    {
                      "alias": "Error rate %",
                      "cell_display_mode": "number",
                      "formula": "failed_count / response_count * 100",
                      "conditional_formats": [
                        { "comparator": "<", "value": 1, "palette": "green_on_white" },
                        { "comparator": "<", "value": 5, "palette": "white_on_yellow" },
                        { "comparator": ">=", "value": 5, "palette": "white_on_red" }
                      ]
                    },
                    { "alias": "Requests/min", "cell_display_mode": "number", "formula": "requests_per_minute" },
                    { "alias": "p90 (ms)", "cell_display_mode": "number", "formula": "p90_duration" },
                    { "alias": "p95 (ms)", "cell_display_mode": "number", "formula": "p95_duration" },
                    { "alias": "p99 (ms)", "cell_display_mode": "number", "formula": "p99_duration" }
                  ],
                  "limit": 100,
                  "sort": { "count": 100, "order_by": [{ "index": 2, "order": "desc", "type": "formula" }] }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": 7789130043401967,
      "definition": {
        "title": "Errors table",
        "type": "group",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "id": 8082075217512991,
            "definition": {
              "type": "note",
              "content": "Metrics carry aggregated counts, not per-event rows, so these tables answer 'which request or check is failing, with what status' rather than NeoLoad's timestamped error list. For individual occurrences read the console log and report.html in the published k6-results artifact. A network-level failure (timeout, reset) arrives as status 0 with a k6 error_code; an HTTP failure carries the real status.\n\nTwo of these three are value-verified against an artifact. Failed checks matched exactly on two runs (7 on copy_event / T004_CopyEvent_04_SearchEvent / Source event found; later 1 + 1 on the two savecrystalreport checks). Dropped iterations matched a run that hit k6's default 10m maxDuration: 32 dropped, and 16 per active minute across the two minutes carrying them. The failed-requests table stays structurally verified only, because no validation run has yet produced a failed HTTP request; re-check it on the first run that does.",
              "background_color": "transparent",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "top",
              "has_padding": true,
              "show_tick": false,
              "tick_edge": "left",
              "tick_pos": "50%"
            }
          },
          {
            "id": 6733973612691783,
            "definition": {
              "title": "Failed requests by request, status and error code",
              "title_align": "left",
              "title_size": "16",
              "type": "query_table",
              "has_search_bar": "auto",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "error_count",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.http_req_failed.total{condition:nonzero,$service,$site,$scenario,$build_number} by {scenario,group,name,status,error_code}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "errors_per_minute",
                      "data_source": "metrics",
                      "aggregator": "avg",
                      "query": "sum:k6perf.http_req_failed.total{condition:nonzero,$service,$site,$scenario,$build_number} by {scenario,group,name,status,error_code}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "total_ms",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.http_req_duration{expected_response:false,$service,$site,$scenario,$build_number} by {scenario,group,name,status,error_code}.rollup(sum, 60)"
                    },
                    {
                      "name": "max_duration",
                      "data_source": "metrics",
                      "aggregator": "max",
                      "query": "max:k6perf.http_req_duration{expected_response:false,$service,$site,$scenario,$build_number} by {scenario,group,name,status,error_code}"
                    }
                  ],
                  "formulas": [
                    {
                      "alias": "Errors",
                      "cell_display_mode": "bar",
                      "formula": "error_count",
                      "conditional_formats": [{ "comparator": ">", "value": 0, "palette": "white_on_red" }]
                    },
                    { "alias": "Errors/min", "cell_display_mode": "number", "formula": "errors_per_minute" },
                    { "alias": "Avg (ms)", "cell_display_mode": "number", "formula": "total_ms / error_count" },
                    { "alias": "Max (ms)", "cell_display_mode": "number", "formula": "max_duration" }
                  ],
                  "limit": 100,
                  "sort": { "count": 100, "order_by": [{ "index": 0, "order": "desc", "type": "formula" }] }
                }
              ]
            }
          },
          {
            "id": 6065941715029147,
            "definition": {
              "title": "Failed checks by check and transaction",
              "title_align": "left",
              "title_size": "16",
              "type": "query_table",
              "has_search_bar": "auto",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "failed_count",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.checks.total{condition:zero,$service,$site,$scenario,$build_number} by {scenario,group,check}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "failures_per_minute",
                      "data_source": "metrics",
                      "aggregator": "avg",
                      "query": "sum:k6perf.checks.total{condition:zero,$service,$site,$scenario,$build_number} by {scenario,group,check}.as_count().rollup(sum, 60)"
                    }
                  ],
                  "formulas": [
                    {
                      "alias": "Failed",
                      "cell_display_mode": "bar",
                      "formula": "failed_count",
                      "conditional_formats": [{ "comparator": ">", "value": 0, "palette": "white_on_red" }]
                    },
                    { "alias": "Failed/min", "cell_display_mode": "number", "formula": "failures_per_minute" }
                  ],
                  "limit": 100,
                  "sort": { "count": 100, "order_by": [{ "index": 0, "order": "desc", "type": "formula" }] }
                }
              ]
            }
          },
          {
            "id": 5020455015880334,
            "definition": {
              "title": "Dropped iterations by scenario",
              "title_align": "left",
              "title_size": "16",
              "type": "query_table",
              "has_search_bar": "never",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "dropped_count",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.dropped_iterations{$service,$site,$scenario,$build_number} by {scenario}.as_count().rollup(sum, 60)"
                    },
                    {
                      "name": "dropped_per_minute",
                      "data_source": "metrics",
                      "aggregator": "avg",
                      "query": "sum:k6perf.dropped_iterations{$service,$site,$scenario,$build_number} by {scenario}.as_count().rollup(sum, 60)"
                    }
                  ],
                  "formulas": [
                    {
                      "alias": "Dropped",
                      "cell_display_mode": "number",
                      "formula": "dropped_count",
                      "conditional_formats": [{ "comparator": ">", "value": 0, "palette": "white_on_red" }]
                    },
                    { "alias": "Dropped/min", "cell_display_mode": "number", "formula": "dropped_per_minute" }
                  ],
                  "limit": 20,
                  "sort": { "count": 20, "order_by": [{ "index": 0, "order": "desc", "type": "formula" }] }
                }
              ]
            }
          }
        ]
      }
    }
  ]
