              "title_align": "left",
              "title_size": "16",
              "type": "timeseries",
              "legend_layout": "horizontal",
              "show_legend": true,
              "markers": [{ "display_type": "warning dashed", "label": "85% saturation", "value": "y = 85" }],
              "yaxis": { "include_zero": true, "label": "Utilization %", "max": "100", "min": "0", "scale": "linear" },
              "right_yaxis": { "include_zero": true, "label": "User load", "scale": "linear" },
              "requests": [
                {
                  "display_type": "line",
                  "q": "avg:k6perf.agent.cpu_percent{$service,$site,$build_number}",
                  "style": { "line_type": "solid", "line_width": "normal", "palette": "orange" }
                },
                {
                  "display_type": "line",
                  "q": "avg:k6perf.agent.ram_percent{$service,$site,$build_number}",
                  "style": { "line_type": "solid", "line_width": "normal", "palette": "purple" }
                },
                {
                  "display_type": "line",
                  "on_right_yaxis": true,
                  "q": "avg:k6perf.vus{$service,$site,$scenario,$build_number}",
                  "style": { "line_type": "dashed", "line_width": "thin", "palette": "cool" }
                }
