                {
                  "aggregator": "max",
                  "q": "max:k6perf.agent.ram_percent{$service,$site,$build_number}",
                  "conditional_formats": [
                    { "comparator": "<", "value": 80, "palette": "white_on_green" },
                    { "comparator": "<", "value": 90, "palette": "white_on_yellow" },
