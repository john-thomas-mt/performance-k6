        "title": "Request duration, throughput and errors",
        "title_align": "left",
        "title_size": "16",
        "type": "timeseries",
        "legend_layout": "horizontal",
        "show_legend": true,
        "yaxis": { "include_zero": true, "label": "Duration (ms)", "scale": "linear" },
        "right_yaxis": { "include_zero": true, "label": "Requests/min and errors/min", "scale": "linear" },
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "total_ms",
                "data_source": "metrics",
                "query": "sum:k6perf.http_req_duration{$service,$site,$scenario,$build_number}.rollup(sum, 60)"
              },
              {
                "name": "request_count",
                "data_source": "metrics",
                "query": "sum:k6perf.http_reqs{$service,$site,$scenario,$build_number}.as_count().rollup(sum, 60)"
              }
            ],
            "formulas": [{ "formula": "total_ms / request_count", "alias": "Avg duration (ms)" }],
            "style": { "line_type": "solid", "line_width": "normal", "palette": "green" }
