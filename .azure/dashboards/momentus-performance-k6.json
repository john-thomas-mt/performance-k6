                  "queries": [
                    {
                      "name": "failed",
                      "data_source": "metrics",
                      "aggregator": "sum",
                      "query": "sum:k6perf.http_req_failed.total{condition:nonzero,$service,$site,$scenario,$build_number}.as_count().rollup(sum, 60)"
